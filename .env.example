# Names only. Never real values — this file IS committed.
# Copy to .env (gitignored) for local development, or use the systemd
# EnvironmentFile in deploy/ for the real thing.

# --- Required. The daemon refuses to start without these. ---

# HMAC shared secret for the API door. Minimum 32 bytes.
#   openssl rand -hex 32
CRSW_SHARED_SECRET=

# Cloudflare Access application AUD tag. Pins JWT validation to THIS app;
# without it, a token minted for any app in your team would validate here.
CRSW_ACCESS_AUD=

# https://<your-team>.cloudflareaccess.com
CRSW_ACCESS_TEAM_DOMAIN=

# Comma-separated. Re-checked in the daemon even though Access enforces it.
CRSW_ALLOWED_EMAILS=

# Comma-separated absolute paths. Sessions may only run under these roots.
# Keep this narrow — it is the real blast-radius control.
CRSW_ALLOWED_ROOTS=

# --- Optional, with defaults ---

CRSW_LISTEN=127.0.0.1:8787
CRSW_SESSION_CAP=8
CRSW_IDLE_TIMEOUT=60m
CRSW_ABSOLUTE_LIFETIME=24h
CRSW_CLOCK_SKEW=5m

# Local development only. Skips the Cloudflare Access layer.
# Excluded from release builds by the `dev` build tag; refuses to start on a
# non-loopback listener. Never set this on a deployed host.
CRSW_DEV_AUTH_BYPASS=false
