# Example systemd *user* unit. Copy outside the repo, fill in, then install to
#   ~/.config/systemd/user/crswd.service
#
# A user unit, not a system one, on purpose: sessions should run as you, with your
# environment and your repo access — not as root. Running this as root would hand
# every session root on the host.
#
# A user manager stops when your last login session ends, and the whole point of
# this daemon is reaching the host when you are not sitting at it. Enable
# lingering once, or the service is up only while you happen to be logged in:
#
#   loginctl enable-linger "$USER"

[Unit]
Description=Claude remote session webhook daemon
Documentation=https://github.com/nctiggy/claude-remote-session-webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# No flags. The daemon defines none — configuration is environment-only and read
# once, before it binds or spawns anything — and flag.Parse rejects a flag it does
# not know, so an ExecStart carrying one does not start at all.
ExecStart=%h/.local/bin/crswd

# The audit trail is structured JSON on stdout, so where stdout goes is where the
# trail is kept. Stated rather than inherited from a distro default, because
# "what happened" depends on it:
#
#   journalctl --user -u crswd -o cat | grep '^{' | jq .
#
# The grep is not optional, and filtering by process is not a substitute for it:
# `_COMM=crswd` narrows the journal to this daemon and the command still fails,
# because the non-JSON lines are the daemon's OWN diagnostics rather than
# systemd's (#88). Both descriptors below are journalled and systemd interleaves
# them into one stream, so the split the daemon does make — every line on stdout
# is a record, every human-readable line is on stderr — is what makes `^{` a
# correct filter, not what separates the two for whoever is reading.
StandardOutput=journal
StandardError=journal

# Four values come from a file OUTSIDE the repo, mode 0600, written at deploy
# time. EnvironmentFile parses NAME=value lines, so write the assignments and not
# the bare values:
#
#   mkdir -p ~/.config/crswd
#   ( umask 077
#     printf 'CRSW_SHARED_SECRET=%s\n' "$(op read 'op://Lobster/crswd/shared-secret')"
#     printf 'CRSW_ACCESS_TEAM_DOMAIN=%s\n' '<team>.cloudflareaccess.com'
#     printf 'CRSW_ACCESS_AUD=%s\n'         '<the Access application AUD tag>'
#     printf 'CRSW_ACCESS_ALLOWED_EMAILS=%s\n' '<you@example.com>'
#   ) > ~/.config/crswd/env
#
# All four are required and the daemon refuses to start without them: the secret
# is layer 2, and the other three are what layer 1 verifies a browser's Access
# assertion against — a daemon that cannot check who the browser is has no
# browser door at all. `.env.example` describes each one.
#
# Never `Environment=` any of them in this file. A unit's contents are readable
# by anyone who can run `systemctl --user show crswd`, and this example is
# committed to a public repository — a value typed here is published forever.
# The secret is the obvious case; the other three name a Cloudflare team, an
# application, and a person.
# Optional, and the leading `-` is what makes it so. The configuration file at
# %h/.config/crswd/config is what install.sh writes and what an operator edits;
# this env file predates it and is kept only so a deployment that still has one
# keeps working. Without the `-`, systemd refuses to start a unit whose
# environment file is absent — which is every machine the installer has ever
# set up, since the installer writes a config and never an env.
EnvironmentFile=-%h/.config/crswd/env

# The rest, inline. This is every remaining variable the daemon reads, and each
# value shown is the daemon's own default, so a line deleted here changes
# nothing. `.env.example` says what each one refuses to start on.
Environment=CRSW_ALLOWED_ROOTS=%h/code

# Whether the create form suggests the immediate subdirectories of the roots
# above. Default: off — listing a filesystem is a disclosure, however mild, and
# one to opt into. It widens nothing: the roots are still the control, and a
# suggested path is checked against them on create exactly as a typed one is.
Environment=CRSW_DISCOVER_ROOTS=

# Extra directories the create form offers, comma-separated and absolute, on top
# of the roots above — which are always offered. Default: empty. It reads no
# filesystem, and a path listed here that is outside the roots is refused on
# create exactly as a typed one is.
Environment=CRSW_WORKDIR_SUGGESTIONS=
Environment=CRSW_LISTEN=127.0.0.1:8765
Environment=CRSW_MAX_SESSIONS=5

# Whether a clean stop destroys every session. Default: off, so a redeploy does
# not cost the fleet — startup adoption reclaims them with their deadlines
# intact. Set true if a stopped daemon should mean nothing left running. A crash
# leaves sessions either way; this governs the clean stop only.
Environment=CRSW_DESTROY_ON_SHUTDOWN=
Environment=CRSW_CREATE_RATE_PER_MIN=6
Environment=CRSW_MAX_BODY_BYTES=65536
Environment=CRSW_MAX_STREAMS=10

# The largest screen a pane capture may return, in lines. A capture past it is
# refused rather than shortened — half a screen is a wrong screen, not a smaller
# one. The daemon never attaches to the sessions it starts, so they keep tmux's
# 80x24 default and nothing real approaches this; it is a tripwire on the
# assumption, not a display limit.
Environment=CRSW_PANE_BOUND=200

# The two start-command variables are quoted because a command line has spaces
# in it, and an unquoted `Environment=` assignment ends at the first one.
#
# What is set here is typed into every new session's shell. The default below is
# what the daemon typed before this was configurable at all, and the named set is
# empty, so both lines can be deleted without changing anything. A create picks
# from the set BY NAME and can never send a command line of its own — see
# `.env.example`, and read `docs/security.md` before adding an entry that starts
# a second unsupervised path into the same unsandboxed shell.
Environment="CRSW_START_COMMAND=claude --dangerously-skip-permissions"
Environment="CRSW_START_COMMANDS="

# Which name in that set the dashboard's remote-control switch means (#58).
# Default: `rc`. With the empty set above there is no such command, so the form
# renders no switch; naming one the set does not define is a startup failure.
# A command line in the set may carry `{name}` and nothing else in braces — it
# becomes the session's own name, so `--name {name}` puts the operator's name on
# the other side instead of one Claude invented.
Environment=CRSW_REMOTE_CONTROL_COMMAND=

# Session lifetimes (#37). Empty means the daemon's own defaults: 24h absolute,
# 60m idle. The MAX pair are ceilings a per-session override may not exceed, and
# default to the values above — so overrides buy nothing until a ceiling is
# raised on purpose.
#
# There is no value meaning "never expires". The ceiling moves as far as an
# operator wants; it does not go away.
Environment=CRSW_SESSION_LIFETIME=
Environment=CRSW_SESSION_LIFETIME_MAX=
Environment=CRSW_IDLE_TIMEOUT=
Environment=CRSW_IDLE_TIMEOUT_MAX=

# There is no unit setting for the signed-request timestamp window (300s). It is
# a constant in the code: it bounds the host, and a deployment that could widen
# it from a unit file could unbound it. Do not add one here expecting it to be
# read — nothing reads it, and nothing tells you so.

# `always` rather than `on-failure`, and self-update is the whole reason. Step 7
# of the update is a deliberate `exit 0` once the new binary has been verified
# and renamed into place — systemd starting the daemon again IS how the update
# takes effect. `on-failure` reads that clean exit as a job finished and does
# nothing, which leaves the host with the new binary installed and no daemon
# running it: an update that reports success and stops the service for good.
#
# It does not make the service unstoppable. `systemctl --user stop crswd` still
# stops it; this governs the daemon ending on its own.
Restart=always
RestartSec=5s

# Longer than the daemon's own 30s shutdown budget (cmd/crswd/main.go), so the
# deadline that fires is the daemon's own. The single ending that certainly
# leaves unsandboxed shells running on the host is a SIGKILL from systemd
# part-way through a verified teardown.
TimeoutStopSec=45s

# tmux is not a child to be reaped along with the unit. A tmux server this daemon
# starts lands in the unit's cgroup, so the default KillMode=control-group would
# destroy every session on any restart — precisely the sessions Manager.Adopt
# exists to take ownership of again.
#
# Killing them is not the safer reading either, because it only works when the
# daemon happened to start the server: attach to tmux from your own shell first
# and the server is outside this cgroup entirely, where systemd's kill never
# reaches it. Teardown here is the daemon's verified teardown, on purpose, rather
# than systemd's approximation of one.
KillMode=process

# Hardening — read what it does not do before adding to it. These protect the
# HOST FROM THE DAEMON. None of them sandboxes a session: sessions run
# `claude --dangerously-skip-permissions` as you, so anything the daemon can
# reach, a session can reach. CRSW_ALLOWED_ROOTS is the real control; keep it
# narrow. See constitution Principle VI.
NoNewPrivileges=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectSystem=full

# Deliberately absent. Each of these breaks the tool rather than bounding it, and
# all three read as obvious additions to anyone hardening this by habit:
#
#   PrivateTmp=true      tmux's socket directory is /tmp/tmux-$UID unless
#                        TMUX_TMPDIR says otherwise. A private /tmp puts the
#                        daemon's tmux server where your own shell cannot see it,
#                        so `tmux attach` stops working and you get two servers
#                        where there should be one. Attaching by hand is why this
#                        daemon uses tmux at all.
#   ProtectHome=         Claude Code reads and writes ~/.claude, ~/.claude.json
#                        and ~/.cache. A read-only home breaks sessions in ways
#                        that surface as unrelated errors inside the pane.
#   ProtectSystem=strict mounts the whole hierarchy read-only, so every directory
#                        tmux and Claude Code write to has to be handed back one
#                        at a time with ReadWritePaths — a list that fails at run
#                        time, in a pane, rather than at install time.

[Install]
WantedBy=default.target
