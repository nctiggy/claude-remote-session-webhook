# crswd configuration — EXAMPLE
#
# Copy this to ~/.config/crswd/config and uncomment only what you mean to
# change. Everything here is commented out, so a fresh copy behaves exactly as a
# daemon with no configuration file at all; each line shows the default where one
# can be written down and an illustration where it cannot. The file is read once,
# before the daemon binds or spawns anything: an edit takes effect on restart,
# and a value that would weaken a bound by accident is a startup failure.
#
# WHERE THIS FILE GOES
#
#   $CRSW_CONFIG_FILE, if it is set — it names the file outright
#   else $XDG_CONFIG_HOME/crswd/config
#   else ~/.config/crswd/config
#
# CRSW_CONFIG_FILE is taken exactly as written, a relative path included. In a
# systemd unit a relative path resolves against that unit's WorkingDirectory and
# not against the directory you ran systemctl from, so name an absolute one
# unless you mean that. A missing file is never an error; one that is there and
# cannot be opened is. `crswd config check` reads the file and says what it
# makes, without starting anything. If it stops loading, the daemon starts from
# the config.bak beside it instead — loudly, naming both files, because your
# most recent edits are then not in effect.
#
# THE FORMAT
#
#   key = value
#   # a comment
#
# Three rules. `#` marks a comment at the start of a line and nowhere else: there
# are no trailing comments, because a shared secret may legitimately contain a
# `#` and stripping from the first one would truncate that secret into a daemon
# that starts, looks healthy, and rejects every request it is sent. The separator
# is the FIRST `=`, because start_commands always carries an `=` inside its
# value. A key is its environment variable without the CRSW_ prefix, lower-cased,
# in [a-z0-9_] — so every variable in .env.example is a key here, and the
# reverse. A misspelled key is refused rather than skipped, and so is a key set
# twice.
#
# Precedence is flag, then environment, then this file, then the built-in
# default, and /settings names which layer each value came from. Nothing in the
# daemon writes this file. Why this format and not JSON, YAML or TOML:
# docs/security.md §5.

# The schema this file was written against. Absent means 1, which is what every
# hand-written file is. A higher number than the daemon understands is refused
# rather than read optimistically: the reason to raise it is that a key changed
# meaning, and guessing at the new meaning sets a bound to something you did not
# write.
version = 1


# --- Required. There is no default, and no way to start without it. ---

# The HMAC shared secret the API client signs with. At least 32 bytes; unset or
# shorter is a startup failure, because a daemon that starts with no
# authentication layer is worse than one that does not start. It is never
# logged, returned in an error, or echoed back — not even its length. Generate
# one with `openssl rand -hex 32`. A file setting any of the three secrets —
# this, access_allowed_emails, dashboard_password — must be mode 0600; a file
# holding none of them is not asked to change.
# shared_secret = paste the output of openssl rand -hex 32 here


# --- The blast radius. Read docs/security.md before widening anything here. ---

# The directories a session may run in: colon-separated (`:`) absolute paths, a
# session confined to one of them or refused. Every entry must already exist as
# a directory that resolves; one that does not is a startup failure, as is an
# empty entry, and two spellings of the same directory collapse to one. This is
# the real containment control — keep it narrow. $HOME itself is never the
# default: SSH keys, cloud credentials and browser profiles all live directly
# under it, which would make the allowlist decorative. Default: $HOME/code,
# announced by a banner on stderr at every start.
# allowed_roots = /home/you/code:/home/you/work

# Offer the immediate subdirectories of each approved root as working-directory
# suggestions on the create form. true or false; anything else — `yes`, `on`,
# `2` — is a startup failure rather than a silent off. It widens nothing: every
# path, suggested or typed, is resolved and checked against allowed_roots on
# create. Off by default, because listing a filesystem is a disclosure, however
# mild, and you opt into it. Default: false.
# discover_roots = false

# Extra directories to offer on the create form, on top of the approved roots
# and any discovered children. Comma-separated (`,`), so a directory whose name
# contains a comma is one you type instead of pick. Every entry must be
# absolute; a relative one is a startup failure because no create could accept
# it, and so is an empty one — a stray comma. Nothing here is checked against
# the filesystem, and a path outside allowed_roots may be listed: it is refused
# on create exactly as a typed one is. This list is a convenience and
# allowed_roots is the control. Default: empty.
# workdir_suggestions = /srv/scratch,/srv/second

# Additional environment variable NAMES a session receives, comma-separated, on
# top of the base set the daemon always gives one: HOME, PATH, SHELL, USER,
# LOGNAME, TERM, LANG, LC_*, XDG_RUNTIME_DIR and TMUX_TMPDIR.
#
# A session never inherits this daemon's environment — not the shared secret, not
# the Access values, not any CRSW_ setting. This is the escape hatch for the one
# more variable a particular workflow needs. It holds names, never values, and
# naming a secret or anything CRSW_ is a startup failure. Default: empty.
# session_environment = SSH_AUTH_SOCK

# host:port for the daemon's own listener. The host must be an IP literal — a
# name can be pointed anywhere by /etc/hosts or a resolver, which would move the
# bind without changing this value — and `:8765` is a name too, an empty host,
# so the wildcard is written 0.0.0.0.
#
# Loopback is the only address a daemon with no browser door may have. Configure
# one — access_enabled with the three Access values, or dashboard_password — and
# a non-loopback literal is permitted, which is how an operator on their own
# network reaches this from the machine they are sitting at. With neither, a
# non-loopback address is a startup failure: the invariant is "never reachable
# without authentication" rather than "never reachable". Default: 127.0.0.1:8765.
# listen = 127.0.0.1:8765

# How many sessions may exist at once. At least 1, a whole number; past it the
# daemon refuses to create rather than degrading the host it runs on.
# Default: 5.
# max_sessions = 5

# Tear every session down when the daemon stops. true or false. It covers only
# the graceful stop; a crash leaves sessions running whatever this says, and
# startup adoption is what reclaims them. Off by default, because a graceful
# restart is overwhelmingly the common case and destroying a fleet to redeploy a
# binary is a cost nobody asked for — set it true for a host being decommissioned
# rather than updated. Default: false.
# destroy_on_shutdown = false

# How long a session may live from creation, whatever it is doing. Go duration
# syntax: `24h`, `90m`. It must be positive, and the word `never` that the
# ceiling below takes is refused here — this is the lifetime every session gets
# without asking, and a daemon that read the word here would be one whose every
# session is immortal by default. Default: 24h.
# session_lifetime = 24h

# The ceiling a per-session lifetime override may not exceed. A create asking
# for more is refused rather than quietly clamped: a caller who asked for thirty
# days and was given one believes they have thirty. Below session_lifetime is a
# startup failure, since every create would then be refused by a ceiling under
# its own default. Default: whatever session_lifetime is.
#
# The word `never` is the one value here that is not a duration: no ceiling at
# all, so a create may ask for a session that never expires. `0` is unset and a
# negative duration is refused rather than read as a second spelling of the
# word — reading either as "forever" would switch off the last deadline over a
# typo. What `never` costs: the absolute deadline is the one bound that is never
# renewed, so with it gone the containment left is allowed_roots and whichever
# door admits callers, and such a session holds an unsandboxed shell until
# somebody destroys it. That is the operator's decision, made here once rather
# than per create — and why only a daemon whose ceiling is gone draws the
# matching switch on the create form. One edge: no session record survives the
# daemon, so a restart adopts such a session from tmux with the built-in 24h
# lifetime and tears it down at once if it is already older.
# session_lifetime_max = 24h

# How long a session may sit idle before the reaper takes it. Go duration
# syntax; it may not be negative, and longer than session_lifetime is a startup
# failure because it could then never fire. `0` is not a disable here — zero
# reads as unset and the built-in 60m applies; switching idle reaping off
# belongs to one session, as a create-time override. Default: 60m.
#
# Idleness is measured from the later of two clocks: when a request last drove
# the session, and when the host itself last saw it produce output — tmux's own
# session activity. A session being worked in is not idle, whether the work is
# the agent printing or a person typing in a terminal attached to it here.
# Watching is still not driving: reading a session — the dashboard, the session
# page, the live stream — advances neither clock, because a forgotten tab must
# never hold an unsandboxed shell open. The second clock can only push the
# deadline further out, so a host that gives no answer for a session leaves it
# exactly as long-lived as it was before that clock existed.
# idle_timeout = 60m

# The ceiling for a per-session idle override, as session_lifetime_max is for
# lifetimes. Below idle_timeout is a startup failure. It takes no `never` and
# needs none: a create may switch idle reaping off for its own session without
# asking this ceiling for room, because that session is still bounded by the
# absolute deadline. Default: whatever idle_timeout is.
# idle_timeout_max = 60m

# How many sessions may be created per minute before the daemon starts refusing
# creates. At least 1. Default: 6.
# create_rate_per_min = 6

# The largest request body the daemon will read, in bytes. At least 1. Past it a
# request is refused rather than truncated. Default: 65536.
# max_body_bytes = 65536


# --- Layer 1: the browser door. Cloudflare Access, or a password, or neither. ---
#
# The three Access values are all three of them or none. None means this daemon
# serves the API and admits nobody to the dashboard, which is a deployment it
# supports and says loudly at every start. Some of them is a startup failure: a
# team domain without an audience is a half-configured door, and a daemon that
# started anyway would refuse every login while looking correctly configured.
# dashboard_password at the foot of this section is the other door, for a daemon
# on an internal network with no Cloudflare in front of it, and configuring both
# is a startup failure. Which door is live decides who may run code on this host,
# and that is the last question a daemon should answer by picking one.

# Declare that Cloudflare Access is the browser door. true or false; anything
# else is a startup failure, as it is for every other boolean here. It selects
# nothing on its own — the three values below have selected the Access door
# since long before this setting existed. What it adds is you saying so, which
# is checkable where an unstated intention is not: on with none of the three,
# the daemon refuses to start instead of serving a closed door; on beside
# dashboard_password, it names the collision instead of choosing. Default: false.
# access_enabled = false

# Your Cloudflare Access team domain, normally <team>.cloudflareaccess.com. A
# full origin is accepted too; http:// is refused unless the host is a loopback
# IP literal, a carve-out for the acceptance tests that skips no validation. It
# is one value because the expected issuer and the key set are both derived from
# it, and configuring them separately would allow a validator checking signatures
# against the wrong authority. Default: none, and the dashboard admits nobody.
# access_team_domain = your-team.cloudflareaccess.com

# The Access application's AUD tag, from the application's settings in the
# Cloudflare dashboard. It is compared for equality against the assertion's
# audience and never parsed, so an assertion minted for another application on
# the same team — or for another team entirely — is refused. Default: none.
# access_aud = the AUD tag from your Access application

# Comma-separated addresses allowed to reach the dashboard. An entry that is
# empty, or that carries a space, is a startup failure: whitespace inside an
# address is the separator typed wrong, and left to run it is an address that
# never matches with nothing saying why. The edge is the gate; this is the daemon
# asserting the gate is configured as you believe, so an Access policy somebody
# widened in the dashboard does not widen this. It is treated as a secret — file
# mode 0600, present-or-absent on /settings — because it names *who* may reach a
# daemon that runs unsandboxed code here. Default: none.
# access_allowed_emails = you@example.com,colleague@example.com

# The password door: the browser door for a daemon on an internal network, where
# there is no Cloudflare edge in front of it and so no assertion for layer 1 to
# validate. At least 16 characters — shorter is a startup failure, because the
# attacker this door is written against is on the same fast network you are. Set
# beside access_enabled or the three values above, the daemon refuses to start.
# It is treated as a secret: file mode 0600, present-or-absent on /settings, and
# it is the one setting that page will not edit — a password settable from the
# page it protects is not a door. Change it here and restart. Default: none, and
# there is no password door.
#
# With no TLS in front of the daemon it crosses the network in clear on every
# sign-in, and anyone who can watch the LAN can read it. That is a real weakness
# of this door rather than a footnote: put a reverse proxy with a certificate in
# front of the daemon, or choose it knowing.
# dashboard_password = paste a long random passphrase here


# --- Bounds on what the dashboard may hold open and believe. ---

# How many live output streams may be open at once — the one thing a browser can
# hold open indefinitely. At least 1. The default is twice max_sessions, so
# every session on a fully loaded host is watchable from two tabs before the
# daemon starts refusing. Default: 10.
# max_streams = 10

# The largest screen a pane capture may return, in lines. At least 1. A capture
# past it is refused rather than shortened: half a screen is a wrong screen, not
# a smaller one. 200 is far above the 24 lines a session here actually has —
# nothing ever attaches to one, so it keeps tmux's 80x24 default — so the bound
# fires on a capture reaching into the scrollback, never on a merely full pane.
# Default: 200.
# pane_bound = 200


# --- What the daemon types into a new session's shell. ---
#
# A create carries a NAME from the set below and never a command line. A route
# that took a command line would make this a general remote-shell service behind
# whatever authenticates it, rather than a Claude session manager — the same
# reason a working directory is chosen from allowed_roots instead of being named
# freely.
#
# Every command line here is checked at startup rather than at delivery, so a bad
# one is a daemon that refuses to boot instead of a session that came up three
# quarters configured. A `;` is refused, because tmux's parser eats one before the
# line is ever typed; so is any control character, which would submit the line
# early; and so is a comma, the list separator. `{name}` is the one substitution
# the daemon makes — the session's own name, restricted to [a-zA-Z0-9-] so it
# cannot change the shape of the line — and any other `{token}` is refused rather
# than typed at a shell.

# The command line bound to the name `default`, which is what a create that asks
# for nothing in particular runs. Default: the line shown below, byte for byte
# what every session started before this was configurable at all.
# start_command = claude --dangerously-skip-permissions

# The named set a create may choose from, spelled as name/command pairs separated
# by commas. Note the `=` inside the value: the parser splits on the first one
# only, which is why this line means what it looks like. Names are [a-z0-9-] and
# at most 32 characters, because a name reaches the audit trail. Naming `default`
# here as well as in start_command is a startup failure rather than one of them
# silently winning — which of two spellings gets typed into an unsandboxed shell
# is the question you can least afford to guess about. Default: none, so the set
# is exactly the one `default` above.
#
# The `rc` line below is an ordinary interactive session that drives itself into
# remote control, so the tmux session *is* the session. A `remote-control
# --spawn=…` launcher puts the conversation on the relay and leaves this daemon's
# pane empty, and an empty pane is a dashboard that cannot show, judge, or
# compact anything. That form still works — write it here if you want it — it is
# simply not what a pane-driven dashboard should ship as its example.
# start_commands = rc=claude --dangerously-skip-permissions "/rc {name}"

# Which entry of that set the dashboard's remote-control switch means. Set to a
# name the set does not have, it is a startup failure: you have said which
# command you mean, and a switch that quietly started plain sessions instead
# would be worse than no switch. Unset means `rc` when you have configured a
# command by that name, and no switch at all when you have not — you are never
# offered a control whose only outcome is a refusal. Default: rc, when a command
# by that name exists.
# remote_control_command = rc
